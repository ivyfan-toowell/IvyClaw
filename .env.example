# .env —— 本课程示例用通义千问（OpenAI 兼容接口）

# 模型
IVC_MODEL_NAME=qwen-max
IVC_MODEL_PROVIDER=openai
IVC_API_KEY=your_api_key_here
IVC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 连接弹性
IVC_MAX_RETRIES=12
IVC_TIMEOUT=60

# 持久化底座（与 3.4 的容器一致）
IVC_POSTGRES_URL=postgresql://user:password@localhost:5432/ivyclaw
IVC_REDIS_URL=redis://localhost:6379/0

# 运行
IVC_LOG_LEVEL=INFO

# LangSmith 追踪配置
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=IvyClaw-Project